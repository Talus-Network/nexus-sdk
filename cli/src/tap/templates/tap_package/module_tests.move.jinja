#[test_only]
extend module nexus_primitives::data;

/// Returns the inline byte length needed by the generated TAP test.
public fun inline_length_for_testing(self: &NexusData): u64 {
    match (self) {
        NexusData::One {
            value: NexusValue::InlineData { bytes },
        } => bytes.length(),
        _ => 0,
    }
}

